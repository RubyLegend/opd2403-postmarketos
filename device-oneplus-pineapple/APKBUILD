# Reference: <https://postmarketos.org/devicepkg>
maintainer=""
pkgname=device-oneplus-pineapple
pkgdesc="OnePlus Pad 2"
pkgver=1
pkgrel=0
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	linux-oneplus-pineapple
	mkbootimg
	android-tools
	agetty
	postmarketos-base
	postmarketos-initramfs
	lz4
	msm-firmware-loader
	soc-qcom
	soc-qcom-vulkan
	soc-qcom-gstreamer-systemd
	soc-qcom-qbootctl
	unl0kr-fbforcerefresh
	make-dynpart-mappings
	hexagonrpcd
	i2c-tools
	firmware-oneplus-pineapple
	qrtr
	linux-firmware-ath12k
	ssc-monitor
	alsa-ucm-conf
	fastrpc
	python3
"
makedepends="devicepkg-dev fastrpc-dev"
source="
	deviceinfo
	modules-initfs
	99-watchdog.conf
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
        # Mask sensorspd service until stabilization
	mkdir -p "$pkgdir/etc/systemd/system"
        ln -s /dev/null "$pkgdir/etc/systemd/system/hexagonrpcd-adsp-sensorspd.service"
	# Add watchdog monitoring to systemd
	mkdir -p "$pkgdir/etc/systemd/system.conf.d"
	cp "$srcdir/99-watchdog.conf" "$pkgdir/etc/systemd/system.conf.d"
}

