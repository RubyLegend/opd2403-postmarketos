--- a/drivers/gpu/drm/panel/panel-novatek-nt36532.c     2026-08-09 07:57:13.776859362 +0200
+++ b/drivers/gpu/drm/panel/panel-novatek-nt36532.c     2026-08-09 22:05:21.276547232 +0200
@@ -23,6 +23,8 @@
 #include <drm/drm_panel.h>
 #include <drm/drm_probe_helper.h>
 
+#include <linux/backlight.h>
+
 struct nt36532 {
 	struct drm_panel panel;
 	struct mipi_dsi_device *dsi[2];
@@ -130,6 +132,26 @@
 						    &panel_info->display_mode);
 }
 
+static int nt36532_bl_update_status(struct backlight_device *bl)
+{
+	struct nt36532 *ctx = bl_get_data(bl);
+	u16 brightness = backlight_get_brightness(bl);
+	int ret;
+	struct mipi_dsi_device *dsi = ctx->dsi[0];
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = dsi };
+
+	mipi_dsi_dcs_set_display_brightness_multi(&dsi_ctx, brightness);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, MIPI_DCS_WRITE_CONTROL_DISPLAY, 0x2c);
+	if ((ret = dsi_ctx.accum_err) > 0)
+		return ret;
+
+	return 0;
+}
+
+static const struct backlight_ops nt36532_bl_ops = {
+	.update_status = nt36532_bl_update_status,
+};
+
 static const struct drm_panel_funcs nt36532_panel_funcs = {
 	.prepare = nt36532_prepare,
 	.unprepare = nt36532_unprepare,
@@ -144,6 +166,10 @@
 	struct device *dev = &dsi->dev;
 	struct device_node *dsi1;
 	struct nt36532 *ctx;
+	struct backlight_properties props = {
+		.type = BACKLIGHT_RAW,
+		.max_brightness = 2047,
+	};
 	int num_dsi = 1;
 	int ret, i;
 
@@ -196,6 +222,14 @@
 	ctx->dsi[0] = dsi;
 	mipi_dsi_set_drvdata(dsi, ctx);
 
+	ctx->panel.backlight = devm_backlight_device_register(dev, "nt36532_bl",
+							      dev, ctx,
+							      &nt36532_bl_ops,
+							      &props);
+	if (IS_ERR(ctx->panel.backlight))
+		return dev_err_probe(dev, PTR_ERR(ctx->panel.backlight),
+				     "Failed to register backlight\n");
+
 	drm_panel_init(&ctx->panel, dev, &nt36532_panel_funcs,
 		       DRM_MODE_CONNECTOR_DSI);
 
