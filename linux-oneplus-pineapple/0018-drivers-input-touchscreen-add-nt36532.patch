+static int novatek_fw_update(struct spi_device* touch_spi, const struct firmware* fw)
+{
+    struct fw_header fw_data;
+    int ret;
+
+    if (fw->size > FW_BUF_SIZE) {
+        dev_err(&touch_spi->dev, "Firmware size %zu exceeds maximum %d bytes\n",
+            fw->size, FW_BUF_SIZE);
+        return -ENOMEM;
+    }
+
+    /* 1. Verify firmware file integrity against vendor checksums */
+    ret = novatek_fw_check_checksum(touch_spi, fw);
+    if (ret) {
+        dev_err(&touch_spi->dev, "Firmware checksum verification failed\n");
+        return -EINVAL;
+    }
+
+    /* 2. Extract partition maps (ILM/DLM addresses, sizes, and CRCs) */
+    ret = novatek_fw_parse_header(touch_spi, fw, &fw_data);
+    if (ret) {
+        dev_err(&touch_spi->dev, "Failed to parse firmware header\n");
+        return -EINVAL;
+    }
+
+    /* 3. Execute the physical SPI hardware flash sequence */
+    ret = novatek_fw_upload(touch_spi, fw, &fw_data);
+    if (ret) {
+        dev_err(&touch_spi->dev, "Hardware firmware upload sequence failed: %d\n", ret);
+        return ret;
+    }
+
+    dev_info(&touch_spi->dev, "Novatek firmware successfully flashed and booted.\n");
+
+    return 0;
+}
