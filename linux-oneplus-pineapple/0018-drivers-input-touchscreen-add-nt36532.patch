+static int novatek_fw_parse_header(struct spi_device* touch_spi, const struct firmware* fw,
+    struct fw_header* fw_data)
+{
+    // const u8* data = fw->data;
+    //
+    // /* The header must be at least large enough to contain the ILM/DLM offsets (0x30 bytes) */
+    // if (fw->size < 0x30) {
+    //     dev_err(panel->dev, "Firmware file too small to contain headers\n");
+    //     return -EINVAL;
+    // }
+    //
+    // /*
+    //  * Extract ILM (Instruction RAM) Partition Info
+    //  * Using get_unaligned_le32 to safely read 32-bit integers from a packed byte array
+    //  */
+    // fw_data->ilm.bin_addr = get_unaligned_le32(&data[0x00]);
+    // fw_data->ilm.sram_addr = get_unaligned_le32(&data[0x04]);
+    // fw_data->ilm.size = get_unaligned_le32(&data[0x08]);
+    // fw_data->ilm.crc = get_unaligned_le32(&data[0x18]);
+    //
+    // /* Extract DLM (Data RAM) Partition Info */
+    // fw_data->dlm.bin_addr = get_unaligned_le32(&data[0x0C]);
+    // fw_data->dlm.sram_addr = get_unaligned_le32(&data[0x10]);
+    // fw_data->dlm.size = get_unaligned_le32(&data[0x14]);
+    // fw_data->dlm.crc = get_unaligned_le32(&data[0x1C]);
+    //
+    // /* Extract Cascade Flag */
+    // fw_data->is_cascade = (data[0x20] & 0x02) >> 1;
+    //
+    // dev_dbg(panel->dev, "ILM: SRAM 0x%X, Size 0x%X. DLM: SRAM 0x%X, Size 0x%X. Cascade: %d\n",
+    //     fw_data->ilm.sram_addr, fw_data->ilm.size,
+    //     fw_data->dlm.sram_addr, fw_data->dlm.size, fw_data->is_cascade);
+    //
+    // /* Boundary Safety Check */
+    // if (fw_data->ilm.bin_addr + fw_data->ilm.size > fw->size || fw_data->dlm.bin_addr + fw_data->dlm.size > fw->size) {
+    //     dev_err(panel->dev, "Firmware partitions exceed file size bounds!\n");
+    //     return -EINVAL;
+    // }
+    //
+    // return 0;
+    const u8* data = fw->data;
+    uint32_t tmp_end, pos = 0x30;
+    uint8_t info_sec_num = 0, ovly_sec_num = 0, ovly_info;
+    uint8_t find_bin_header = 0;
+    uint32_t list = 0, i;
+
+    if (fw->size < 0x30)
+        return -EINVAL;
+
+    tmp_end = get_unaligned_le32(&data[0]);
+    fw_data->is_cascade = (data[0x20] & 0x02) >> 1;
+
+    if (fw_data->is_cascade) {
+        while (pos < (tmp_end / 2)) {
+            info_sec_num++;
+            pos += 0x10;
+        }
+        info_sec_num++;
+    } else {
+        while (pos < tmp_end) {
+            info_sec_num++;
+            pos += 0x10;
+        }
+    }
+
+    ovly_info = (data[0x28] & 0x10) >> 4;
+    ovly_sec_num = ovly_info ? (data[0x28] & 0x0F) : 0;
+
+    fw_data->num_partitions = 2 + ovly_sec_num + info_sec_num;
+    if (fw_data->num_partitions > MAX_PARTITIONS)
+        return -EINVAL;
+
+    /* Parse ILM (0) & DLM (1) */
+    for (list = 0; list < 2; list++) {
+        fw_data->parts[list].bin_addr = get_unaligned_le32(&data[0 + list * 12]);
+        fw_data->parts[list].sram_addr = get_unaligned_le32(&data[4 + list * 12]);
+        fw_data->parts[list].size = get_unaligned_le32(&data[8 + list * 12]);
+        fw_data->parts[list].crc = get_unaligned_le32(&data[0x18 + list * 4]);
+    }
+
+    /* Parse Info Sections (with the cascade jump hack!) */
+    for (i = 0; i < info_sec_num; i++, list++) {
+        if (find_bin_header == 0) {
+            pos = 0x30 + (0x10 * i);
+        } else if (find_bin_header && fw_data->is_cascade) {
+            pos = tmp_end - 0x10; /* Jump to the end of the header block */
+        }
+
+        fw_data->parts[list].sram_addr = get_unaligned_le32(&data[pos]);
+        fw_data->parts[list].size = get_unaligned_le32(&data[pos + 4]);
+        fw_data->parts[list].bin_addr = get_unaligned_le32(&data[pos + 8]);
+        fw_data->parts[list].crc = get_unaligned_le32(&data[pos + 12]);
+
+        /* Flag that we found the final bin boundary so the next loop jumps */
+        if ((fw_data->parts[list].bin_addr < tmp_end) && (fw_data->parts[list].size != 0)) {
+            find_bin_header = 1;
+        }
+    }
+
+    /* Parse DLM Overlay Sections */
+    for (i = 0; i < ovly_sec_num; i++, list++) {
+        pos = fw_data->parts[1].bin_addr + (0x10 * i);
+        fw_data->parts[list].sram_addr = get_unaligned_le32(&data[pos]);
+        fw_data->parts[list].size = get_unaligned_le32(&data[pos + 4]);
+        fw_data->parts[list].bin_addr = get_unaligned_le32(&data[pos + 8]);
+        fw_data->parts[list].crc = get_unaligned_le32(&data[pos + 12]);
+    }
+
+    return 0;
+}
