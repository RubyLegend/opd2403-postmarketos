+static int nvt_ts_read_touch_data(struct novatek_ts_data* ts)
+{
+    struct spi_transfer t = { 0 };
+    struct spi_message m;
+    int ret;
+
+    /* Novatek proprietary SPI read format: mask the read command */
+    ts->rx_buf[0] = 0x80 & 0x7F; /* Example: adjust this to match your FW's read command */
+
+    t.tx_buf = ts->rx_buf;
+    t.rx_buf = ts->rx_buf;
+    t.len = NVT_TS_POINT_DATA_LEN + 2;
+
+    spi_message_init(&m);
+    spi_message_add_tail(&t, &m);
+
+    ret = spi_sync(ts->spi, &m);
+    if (ret < 0) {
+        dev_err(&ts->spi->dev, "SPI touch read failed: %d\n", ret);
+        return ret;
+    }
+
+    return 0;
+}
