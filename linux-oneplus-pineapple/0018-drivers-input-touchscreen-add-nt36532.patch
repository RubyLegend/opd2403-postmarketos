+        (crc_flags >> 2) & 0x01, (crc_flags >> 0) & 0x01, (crc_flags >> 1) & 0x01);
+
+    /* Read ILM (Instruction RAM) Checksum */
+    nvt_set_page(spi, NVT_G_ILM_CHECKSUM_ADDR);
+    nvt_spi_read_block(spi, NVT_G_ILM_CHECKSUM_ADDR, buf, 4);
+    g_crc = buf[0] | (buf[1] << 8) | (buf[2] << 16) | (buf[3] << 24);
+
+    nvt_set_page(spi, NVT_R_ILM_CHECKSUM_ADDR);
+    nvt_spi_read_block(spi, NVT_R_ILM_CHECKSUM_ADDR, buf, 4);
+    r_crc = buf[0] | (buf[1] << 8) | (buf[2] << 16) | (buf[3] << 24);
+
+    dev_err(&spi->dev, "ILM Checksum: bin=0x%08X, golden=0x%08X, result=0x%08X\n",
+        fw_data->parts[0].crc, g_crc, r_crc);
+
+    /* Read DLM (Data RAM) Checksum */
+    nvt_set_page(spi, NVT_G_DLM_CHECKSUM_ADDR);
+    nvt_spi_read_block(spi, NVT_G_DLM_CHECKSUM_ADDR, buf, 4);
+    g_crc = buf[0] | (buf[1] << 8) | (buf[2] << 16) | (buf[3] << 24);
+
+    nvt_set_page(spi, NVT_R_DLM_CHECKSUM_ADDR);
+    nvt_spi_read_block(spi, NVT_R_DLM_CHECKSUM_ADDR, buf, 4);
+    r_crc = buf[0] | (buf[1] << 8) | (buf[2] << 16) | (buf[3] << 24);
+
+    dev_err(&spi->dev, "DLM Checksum: bin=0x%08X, golden=0x%08X, result=0x%08X\n",
+        fw_data->parts[1].crc, g_crc, r_crc);
+}
