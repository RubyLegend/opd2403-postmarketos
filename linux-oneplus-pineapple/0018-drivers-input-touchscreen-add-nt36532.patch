+                ret = -EINVAL;
+        }
+
+        return ret;
+}*/
+static unsigned int CheckSum(const u8* data, size_t len)
+{
+    uint32_t i = 0;
+    uint32_t checksum = 0;
+
+    for (i = 0; i < len; i++) {
+        checksum += data[i];
+    }
+
+    checksum += (len - 1);
+    checksum = ~checksum + 1;
+
+    return checksum;
+}
+
+static int novatek_fw_check_checksum(struct spi_device* touch_spi, const struct firmware* fw)
+{
+    uint32_t checksum_calculated = 0;
+    uint32_t checksum_bin = 0;
+    size_t payload_size;
+
+    if (fw->size <= FW_BIN_CHECKSUM_LEN)
+        return -EINVAL;
+
+    payload_size = fw->size - FW_BIN_CHECKSUM_LEN;
+
+    /* Get the expected checksum embedded at the very end of the file */
+    checksum_bin = le32_to_cpup((__le32*)&fw->data[payload_size]);
+
+    checksum_calculated = CheckSum(fw->data, payload_size);
+
+    if (checksum_calculated != checksum_bin) {
+        dev_err(&touch_spi->dev, "Checksum mismatch! Calc: 0x%08X, Bin: 0x%08X\n",
+            checksum_calculated, checksum_bin);
+        return -EINVAL;
+    }
+
+    return 0;
+}
