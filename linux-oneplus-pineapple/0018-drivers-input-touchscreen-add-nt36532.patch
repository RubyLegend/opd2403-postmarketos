+static int nvt_spi_write_cmd(struct spi_device* spi, u8* cmd, size_t len)
+{
+    u8* dma_buf;
+    int ret;
+
+    dma_buf = kmemdup(cmd, len, GFP_KERNEL);
+    if (!dma_buf)
+        return -ENOMEM;
+
+    /* Vendor masking: Highest bit must be 0 for Write */
+    dma_buf[0] |= 0x80;
+
+    ret = spi_write(spi, dma_buf, len);
+    kfree(dma_buf);
+    return ret;
+}
