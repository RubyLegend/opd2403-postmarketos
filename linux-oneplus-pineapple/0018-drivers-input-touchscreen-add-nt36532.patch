+static int nvt_spi_read_cmd(struct spi_device* spi, u8 reg_offset, u8* val)
+{
+    u8* dma_buf;
+    int ret;
+    struct spi_transfer t = { 0 };
+    struct spi_message m;
+
+    dma_buf = kzalloc(3, GFP_KERNEL);
+    if (!dma_buf)
+        return -ENOMEM;
+
+    // READ - & 0x7F, WRITE - | 0x80
+    dma_buf[0] = reg_offset & 0x7F;
+    dma_buf[1] = 0xFF; /* Dummy byte to clock the MISO line */
+
+    t.tx_buf = dma_buf;
+    t.rx_buf = dma_buf;
+    t.len = 3;
+
+    spi_message_init(&m);
+    spi_message_add_tail(&t, &m);
+
+    ret = spi_sync(spi, &m);
+    if (!ret)
+        *val = dma_buf[2];
+
+    kfree(dma_buf);
+    return ret;
+}
