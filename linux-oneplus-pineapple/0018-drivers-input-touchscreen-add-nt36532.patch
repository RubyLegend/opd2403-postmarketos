+    chip_info->fwbuf[2] = (size >> 8) & 0xFF;
+    chip_info->fwbuf[3] = (size >> 16) & 0xFF;
+    if (chip_info->hw_crc == HWCRC_LEN_2Bytes) {
+        CTP_SPI_WRITE(chip_info->s_client, chip_info->fwbuf, 3);
