+static int novatek_write_partition(struct spi_device* spi, const struct firmware* fw,
+    struct nvt_partition* part)
+{
+    uint32_t sram_addr = part->sram_addr;
+    uint32_t bin_addr = part->bin_addr;
+    uint32_t size = part->size;
+    uint32_t count, i;
+    uint16_t len;
+    u8* dma_buf;
+    int ret = 0;
+
+    if (!size)
+        return 0; /* Ignore empty partitions */
+
+    if (bin_addr + size > fw->size) {
+        dev_err(&spi->dev, "Partition out of bounds: addr 0x%X size 0x%X\n", bin_addr, size);
+        return -EINVAL;
+    }
+
+    size += 1; /* Vendor zero-index compensation */
+
+    /* Allocate DMA buffer for 128 bytes of data + 1 byte for the offset address */
+    dma_buf = kzalloc(NVT_TRANSFER_LEN + 1, GFP_KERNEL);
+    if (!dma_buf)
+        return -ENOMEM;
+
+    count = (size / NVT_TRANSFER_LEN) + ((size % NVT_TRANSFER_LEN) ? 1 : 0);
+
+    for (i = 0; i < count; i++) {
+        len = (size < NVT_TRANSFER_LEN) ? size : NVT_TRANSFER_LEN;
+
+        /* 1. Set the page to the current SRAM address */
+        ret = nvt_set_page(spi, sram_addr);
+        if (ret)
+            break;
+
+        /* 2. Format the buffer: [Offset Address] [ ... Data ... ] */
+        /* Note: We enforce the 0x7F Write Mask on the first byte */
+        dma_buf[0] = (sram_addr & 0x7F) | 0x80;
+        memcpy(dma_buf + 1, &fw->data[bin_addr], len);
+
+        /* 3. Blast the chunk over SPI directly */
+        ret = spi_write(spi, dma_buf, len + 1);
+        if (ret) {
+            dev_err(&spi->dev, "SPI write failed at SRAM 0x%X\n", sram_addr);
+            break;
+        }
+
+        sram_addr += NVT_TRANSFER_LEN;
+        bin_addr += NVT_TRANSFER_LEN;
+        size -= NVT_TRANSFER_LEN;
+    }
+
+    kfree(dma_buf);
+    return ret;
+}
