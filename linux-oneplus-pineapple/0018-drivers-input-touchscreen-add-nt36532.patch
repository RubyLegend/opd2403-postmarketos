+/* Mainline helper for multi-byte SPI reads */
+static int nvt_spi_read_block(struct spi_device* spi, unsigned int reg_offset, u8* data, size_t len)
+{
+    u8* dma_buf;
+    int ret;
+    struct spi_transfer t = { 0 };
+    struct spi_message m;
+
+    /* Total transfer size: 1 CMD + 1 DUMMY + len DATA */
+    dma_buf = kzalloc(2 + len, GFP_KERNEL);
+    if (!dma_buf)
+        return -ENOMEM;
+
+    /* Set Read Mask (MSB = 0) and Dummy Byte */
+    dma_buf[0] = reg_offset & 0x7F;
+    dma_buf[1] = 0xFF;
+
+    t.tx_buf = dma_buf;
+    t.rx_buf = dma_buf;
+    t.len = 2 + len;
+
+    spi_message_init(&m);
+    spi_message_add_tail(&t, &m);
+
+    ret = spi_sync(spi, &m);
+    if (!ret)
+        memcpy(data, &dma_buf[2], len); /* Copy the data payload out */
+
+    kfree(dma_buf);
+    return ret;
+}
