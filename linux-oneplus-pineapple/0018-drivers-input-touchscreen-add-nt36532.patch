+static irqreturn_t novatek_ts_irq(int irq, void* dev_id)
+{
+    struct novatek_ts_data* ts = dev_id;
+    int i, error, slot, x, y, width, pressure;
+    bool active;
+    u8* point;
+
+    error = nvt_ts_read_touch_data(ts);
+    if (error)
+        return IRQ_HANDLED;
+
+    /* Adjust the offset (+1 or +2) based on your SPI dummy byte response */
+    u8* payload = &ts->rx_buf[1];
+
+    /* Verify payload integrity */
+    if (nvt_ts_point_checksum(payload, NVT_TS_CHECKSUM_LEN))
+        return IRQ_HANDLED;
+
+    for (i = 0; i < ts->max_touches; i++) {
+        point = &payload[1 + (6 * i)];
+
+        if (point[0] == NVT_TS_TOUCH_INVALID)
+            continue;
+
+        slot = (point[0] >> NVT_TS_TOUCH_SLOT_SHIFT) - 1;
+        if (slot < 0 || slot >= ts->max_touches)
+            continue;
+
+        switch (point[0] & NVT_TS_TOUCH_TYPE_MASK) {
+        case NVT_TS_STATUS_ENTER:
+        case NVT_TS_STATUS_MOVING:
+            active = true;
+            break;
+        default:
+            active = false;
+            break;
+        }
+
+        input_mt_slot(ts->input, slot);
+        input_mt_report_slot_state(ts->input, MT_TOOL_FINGER, active);
+
+        if (active) {
+            x = (point[1] << 8) | point[2];
+            y = (point[3] << 8) | point[4];
+            width = point[5] ? point[5] : 1;
+            pressure = point[6] ? point[6] : 1;
+
+            // dev_info(&ts->spi->dev, "Touch Debug - Slot %d: raw_x=%d, raw_y=%d, width=%d, pressure=%d\n",
+            //     slot, x, y, width, pressure);
+
+            touchscreen_report_pos(ts->input, &ts->prop, x, y, true);
+            input_report_abs(ts->input, ABS_MT_TOUCH_MAJOR, width);
+            input_report_abs(ts->input, ABS_MT_PRESSURE, pressure);
+        }
+    }
+
+    input_mt_sync_frame(ts->input);
+    input_sync(ts->input);
+
+    return IRQ_HANDLED;
+}
+
+static int novatek_ts_power_on(struct novatek_ts_data* ts)
+{
+    if (ts->reset_gpio) {
+        gpiod_set_value_cansleep(ts->reset_gpio, 1);
+        msleep(20);
+        gpiod_set_value_cansleep(ts->reset_gpio, 0);
+        msleep(50);
+        gpiod_set_value_cansleep(ts->reset_gpio, 1);
+        msleep(20);
+    }
+
+    return 0;
+}
+
+static void novatek_ts_power_off(struct novatek_ts_data* ts)
+{
+    if (ts->reset_gpio)
+        gpiod_set_value_cansleep(ts->reset_gpio, 0);
+}
+
+static int novatek_ts_panel_prepared(struct drm_panel_follower* follower)
+{
+    struct novatek_ts_data* ts = container_of(follower, struct novatek_ts_data, panel_follower);
+
+    /* 1. Wake up the SPI bus after DSI init */
+    novatek_ts_power_on(ts);
+
+    /* 2. Upload cached firmware */
+    return novatek_fw_load(ts);
+}
+
+static int novatek_ts_panel_unpreparing(struct drm_panel_follower* follower)
+{
+    struct novatek_ts_data* ts = container_of(follower, struct novatek_ts_data, panel_follower);
+
+    disable_irq_nosync(ts->spi->irq);
+    novatek_ts_power_off(ts);
+
+    return 0;
+}
+
+static const struct drm_panel_follower_funcs novatek_ts_follower_funcs = {
+    .panel_prepared = novatek_ts_panel_prepared,
+    .panel_unpreparing = novatek_ts_panel_unpreparing,
+};
+
+static int novatek_ts_probe(struct spi_device* spi)
+{
+    struct device* dev = &spi->dev;
+    struct novatek_ts_data* ts;
+    int error;
+
+    if (spi->irq <= 0)
+        spi->irq = of_irq_get(dev->of_node, 0);
+
+    if (spi->irq <= 0) {
+        dev_err(dev, "Failed to acquire IRQ from DT\n");
+        return -EINVAL;
+    }
+
+    ts = devm_kzalloc(dev, sizeof(*ts), GFP_KERNEL);
+    if (!ts)
+        return -ENOMEM;
+
+    ts->spi = spi;
+    ts->max_touches = NVT_TS_MAX_TOUCHES;
+    spi_set_drvdata(spi, ts);
+
+    /* SPI Bus Configuration */
+    spi->mode = SPI_MODE_0;
+    spi->bits_per_word = 8;
+    error = spi_setup(spi);
+    if (error) {
+        dev_err(dev, "Failed to setup SPI device: %d\n", error);
+        return error;
+    }
+
+    ts->reset_gpio = devm_gpiod_get_optional(dev, "reset", GPIOD_OUT_HIGH);
+    if (IS_ERR(ts->reset_gpio))
+        return dev_err_probe(dev, PTR_ERR(ts->reset_gpio), "Failed to get reset GPIO\n");
+
+    /* Input Device Setup */
+    ts->input = devm_input_allocate_device(dev);
+    if (!ts->input) {
+        error = -ENOMEM;
+        goto err_power_off;
+    }
+
+    ts->input->name = "Novatek NT36532 Touchscreen";
+    ts->input->id.bustype = BUS_SPI;
+
+    input_set_abs_params(ts->input, ABS_MT_POSITION_X, 0, NVT_TS_DEFAULT_MAX_X - 1, 0, 0);
+    input_set_abs_params(ts->input, ABS_MT_POSITION_Y, 0, NVT_TS_DEFAULT_MAX_Y - 1, 0, 0);
+    input_set_abs_params(ts->input, ABS_MT_TOUCH_MAJOR, 0, 255, 0, 0);
+    input_set_abs_params(ts->input, ABS_MT_PRESSURE, 0, 1000, 0, 0);
+
+    touchscreen_parse_properties(ts->input, true, &ts->prop);
+
+    error = input_mt_init_slots(ts->input, ts->max_touches,
+        INPUT_MT_DIRECT | INPUT_MT_DROP_UNUSED);
+    if (error)
+        goto err_power_off;
+
+    input_set_drvdata(ts->input, ts);
+
+    error = devm_request_threaded_irq(dev, spi->irq, NULL, novatek_ts_irq,
+        IRQF_ONESHOT | IRQF_TRIGGER_FALLING,
+        "novatek_nt36532_ts", ts);
+    if (error) {
+        dev_err(dev, "Failed to register threaded IRQ: %d\n", error);
+        goto err_power_off;
+    }
+
+    error = input_register_device(ts->input);
+    if (error) {
+        dev_err(dev, "Failed to register input device: %d\n", error);
+        goto err_power_off;
+    }
+
+    ts->panel_follower.funcs = &novatek_ts_follower_funcs;
+    error = drm_panel_add_follower(&spi->dev, &ts->panel_follower);
+    if (error) {
+        release_firmware(ts->fw);
+        return dev_err_probe(&spi->dev, error, "Failed to register panel follower\n");
+    }
+
+    return 0;
+
+err_power_off:
+    novatek_ts_power_off(ts);
+    return error;
+}
+
+static void novatek_ts_remove(struct spi_device* spi)
+{
+    struct novatek_ts_data* ts = spi_get_drvdata(spi);
+
+    drm_panel_remove_follower(&ts->panel_follower);
+    if (ts->fw)
+        release_firmware(ts->fw);
+    novatek_ts_power_off(ts);
+}
+
+static int novatek_ts_suspend(struct device* dev)
+{
+    struct novatek_ts_data* ts = spi_get_drvdata(to_spi_device(dev));
+
+    disable_irq(ts->spi->irq);
+    novatek_ts_power_off(ts);
+
+    return 0;
+}
+
+static int novatek_ts_resume(struct device* dev)
+{
+    struct novatek_ts_data* ts = spi_get_drvdata(to_spi_device(dev));
+    int ret;
+
+    ret = novatek_ts_power_on(ts);
+    if (ret)
+        return ret;
+
+    ret = novatek_fw_load(ts);
+    if (ret)
+        return ret;
+
+    enable_irq(ts->spi->irq);
+
+    return 0;
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(novatek_ts_pm_ops, novatek_ts_suspend, novatek_ts_resume);
+
+static const struct of_device_id novatek_ts_of_match[] = {
+    { .compatible = "novatek,nt36532-ts" },
+    { }
+};
+MODULE_DEVICE_TABLE(of, novatek_ts_of_match);
+
+static const struct spi_device_id novatek_ts_spi_id[] = {
+    { "nt36532-ts", 0 },
+    { }
+};
+MODULE_DEVICE_TABLE(spi, novatek_ts_spi_id);
+
+static struct spi_driver novatek_ts_driver = {
+    .driver = {
+        .name = "novatek-nt36532-ts",
+        .pm = pm_sleep_ptr(&novatek_ts_pm_ops),
+        .of_match_table = novatek_ts_of_match,
+    },
+    .probe = novatek_ts_probe,
+    .remove = novatek_ts_remove,
+    .id_table = novatek_ts_spi_id,
+};
+
+module_spi_driver(novatek_ts_driver);
+
+MODULE_DESCRIPTION("Touchscreen Driver for Novatek NT36532 Touchscreen");
+MODULE_AUTHOR("Serhii Hatsan <serhiihatcan@gmail.com>");
+MODULE_LICENSE("GPL");
