+/*static void nvt_set_bld_crc_bank(struct spi_device* spi,
+    uint32_t DES_ADDR, uint32_t SRAM_ADDR,
+    uint32_t LENGTH_ADDR, uint32_t size,
+    uint32_t G_CHECKSUM_ADDR, uint32_t crc)
