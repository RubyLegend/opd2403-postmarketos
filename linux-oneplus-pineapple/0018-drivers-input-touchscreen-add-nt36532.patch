+static int novatek_fw_enable_crc(struct spi_device* spi)
+{
+    int ret;
+
+    /* Set memory pager to EVENT_BUF_ADDR */
+    ret = nvt_set_page(spi, NVT_EVENT_BUF_ADDR);
+    if (ret)
+        return ret;
+
+    /* Clear FW reset status */
+    ret = nvt_write_addr(spi, NVT_EVENT_BUF_ADDR | EVENT_MAP_RESET_COMPLETE, 0x00);
+    if (ret)
+        return ret;
+
+    /* Enable HW CRC Verification */
+    return nvt_write_addr(spi, NVT_EVENT_BUF_ADDR | EVENT_MAP_HOST_CMD, 0xAE);
+}
+
+static int novatek_fw_boot_ready(struct spi_device* spi)
+{
+    int ret;
+
+    ret = nvt_write_addr(spi, NVT_BOOT_RDY_ADDR, 0x01);
+    if (ret)
+        return ret;
+
+    mdelay(5); /* Wait for MCU to switch execution contexts */
+
+    /* Reset the memory pager back to the standard event buffer */
+    return nvt_set_page(spi, NVT_EVENT_BUF_ADDR);
+}
