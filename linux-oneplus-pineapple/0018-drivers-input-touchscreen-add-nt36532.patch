+static int nvt_set_bld_crc_bank(struct spi_device* spi,
+    uint32_t des_addr, uint32_t sram_addr,
+    uint32_t length_addr, uint32_t size,
+    uint32_t checksum_addr, uint32_t crc)
+{
+    u8 buf[5];
+    int ret;
+
+    /* 1. Write Destination Address (Offset + 3 bytes SRAM Addr) */
+    ret = nvt_set_page(spi, des_addr);
+    if (ret)
+        return ret;
+
+    buf[0] = des_addr & 0x7F;
+    buf[1] = sram_addr & 0xFF;
+    buf[2] = (sram_addr >> 8) & 0xFF;
+    buf[3] = (sram_addr >> 16) & 0xFF;
+    ret = nvt_spi_write_cmd(spi, buf, 4);
+    if (ret)
+        return ret;
+
+    /* 2. Write Length (Offset + 3 bytes Size)
+     * Modern Novatek ICs (like NT36532) use 3-byte hardware CRC lengths.
+     */
+    buf[0] = length_addr & 0x7F;
+    buf[1] = size & 0xFF;
+    buf[2] = (size >> 8) & 0xFF;
+    buf[3] = (size >> 16) & 0xFF;
+    ret = nvt_spi_write_cmd(spi, buf, 4);
+    if (ret)
+        return ret;
+
+    /* 3. Write Golden Checksum (Offset + 4 bytes CRC) */
+    buf[0] = checksum_addr & 0x7F;
+    buf[1] = crc & 0xFF;
+    buf[2] = (crc >> 8) & 0xFF;
+    buf[3] = (crc >> 16) & 0xFF;
+    buf[4] = (crc >> 24) & 0xFF;
+    ret = nvt_spi_write_cmd(spi, buf, 5);
+
+    return ret;
+}
