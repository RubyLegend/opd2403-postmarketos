+static int novatek_fw_load(struct novatek_ts_data* ts)
+{
+    dev_info(&ts->spi->dev, "Loading Novatek NT36532 firmware over SPI...\n");
+
+    int ret;
+
+    if (!ts->fw) {
+        ret = request_firmware(&ts->fw, "csot-ppc100hb1-1.fw", &ts->spi->dev);
+        if (ret) {
+            dev_err(&ts->spi->dev, "Failed to load firmware: %d\n", ret);
+            return ret;
+        }
+        dev_info(&ts->spi->dev, "Firmware cached in RAM, size: %zu bytes\n", ts->fw->size);
+    }
+
+    dev_info(&ts->spi->dev, "Firmware loaded into memory, size: %zu bytes\n", ts->fw->size);
+
+    ret = novatek_fw_update(ts->spi, ts->fw);
+
+    if (ret) {
+        dev_err(&ts->spi->dev, "Failed to update firmware: %d\n", ret);
+        return ret;
+    }
+
+    return 0;
+}
