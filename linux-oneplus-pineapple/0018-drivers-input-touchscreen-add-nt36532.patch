+static int novatek_fw_upload(struct spi_device* spi,
+    const struct firmware* fw, struct fw_header* fw_data)
+{
+    int ret, i;
+
+    /* 1. Halt MCU and wipe pointers */
+    novatek_bootloader_reset(spi);
+
+    /* 2. Configure ILM/DLM memory banks for the incoming firmware payload */
+    novatek_set_bld_hw_crc(spi, fw_data);
+
+    /* 3. Handle Cascade (Dual-Chip) Auto-Copy Setup */
+    if (fw_data->is_cascade) {
+        ret = novatek_tx_auto_copy_mode(spi, 0x56); // Matches nt36532, which is TX_AUTO_COPY_EN.
+        if (ret) {
+            dev_err(&spi->dev, "Failed to enable cascade auto-copy mode\n");
+            return ret;
+        }
+    }
+
+    /* 4. Stream the firmware chunks over SPI */
+    // ret = novatek_fw_write(spi, fw, fw_data);
+    // if (ret) {
+    //     dev_err(panel->dev, "Firmware SPI stream failed: %d\n", ret);
+    //     novatek_stop_crc_reboot(spi); /* Emergency halt to prevent bootlooping */
+    //     return ret;
+    // }
+    /* 4. Stream all partitions */
+    for (i = 0; i < fw_data->num_partitions; i++) {
+        ret = novatek_write_partition(spi, fw, &fw_data->parts[i]);
+        if (ret) {
+            novatek_stop_crc_reboot(spi);
+            return ret;
+        }
+    }
+
+    /* 5. Wait for Cascade Auto-Copy to finish */
+    if (fw_data->is_cascade) {
+        ret = novatek_wait_auto_copy(spi);
+        if (ret) {
+            dev_err(&spi->dev, "Cascade auto-copy wait failed\n");
+            novatek_stop_crc_reboot(spi);
+            return ret;
+        }
+    }
+
+    /* 6. Tell the hardware to verify the checksum */
+    novatek_fw_enable_crc(spi);
+
+    /* 7. Flip the execution switch */
+    novatek_fw_boot_ready(spi);
+
+    /* 8. Wait for the MCU to confirm it successfully booted the payload */
+    ret = novatek_fw_check_reset_state(spi);
+    if (ret) {
+        dev_err(&spi->dev, "Novatek MCU failed to boot the firmware\n");
+
+        /* Print diagnostic hardware error flags to dmesg to see exactly why it failed */
+        novatek_read_bld_hw_crc(spi, fw_data);
+        novatek_stop_crc_reboot(spi);
+        return ret;
+    }
+
+    return 0;
+}
