+static int nvt_ts_point_checksum(const u8* buf, size_t length)
+{
+    u8 checksum = 0;
+    size_t i;
+
+    for (i = 0; i < length - 1; i++)
+        checksum += buf[i + 1];
+
+    checksum = (~checksum + 1);
+
+    if (checksum != buf[length]) {
+        return -EBADMSG;
+    }
+
+    return 0;
+}
