+#define SBL_MINIDUMP_SMEM_ID	602
+#define MD_REGION_VALID		('V' << 24 | 'A' << 16 | 'L' << 8 | 'I' << 0)
+#define MD_SS_ENCR_NOTREQ	(0 << 24 | 0 << 16 | 'N' << 8 | 'R' << 0)
+#define MD_SS_ENCR_DONE		('D' << 24 | 'O' << 16 | 'N' << 8 | 'E' << 0)
+#define MD_SS_ENABLED		('E' << 24 | 'N' << 16 | 'B' << 8 | 'L' << 0)
+
+struct md_ss_region {
+	char	name[16];
+	u32	seq_num;
+	u32	md_valid;
+	u64	region_base_address;
+	u64	region_size;
+};
+
+struct md_ss_toc {
+	u32	md_ss_toc_init;
+	u32	md_ss_enable_status;
+	u32	encryption_status;
+	u32	encryption_required;
+	u32	ss_region_count;
+	u64	md_ss_smem_regions_baseptr;
+};
+
+struct md_global_toc {
+	u32		md_toc_init;
+	u32		md_revision;
+	u32		md_enable_status;
+	struct md_ss_toc md_ss_toc[];
+};
+
+static void md_set_region(struct md_ss_region *r, const char *name,
+			  phys_addr_t base, size_t size)
+{
+	strscpy(r->name, name, sizeof(r->name));
+	r->md_valid = MD_REGION_VALID;
+	r->region_base_address = base;
+	r->region_size = size;
+}
+
+static void pad2_minidump_register(struct work_struct *work);
+static DECLARE_DELAYED_WORK(pad2_minidump_work, pad2_minidump_register);
+static int pad2_minidump_tries;
+
+static void pad2_minidump_register(struct work_struct *work)
+{
+	struct md_global_toc *gtoc;
+	struct md_ss_region *regions;
+	struct md_ss_toc *toc;
+	struct device_node *np;
+	struct resource res;
+	int n = 0;
+
+	/* SMEM probes after late_initcall */
+	gtoc = qcom_smem_get(QCOM_SMEM_HOST_ANY, SBL_MINIDUMP_SMEM_ID, NULL);
+	if (PTR_ERR(gtoc) == -EPROBE_DEFER && ++pad2_minidump_tries < 60) {
+		schedule_delayed_work(&pad2_minidump_work, HZ / 2);
+		return;
+	}
+	if (IS_ERR(gtoc)) {
+		pr_err("smem item %d: %ld\n", SBL_MINIDUMP_SMEM_ID, PTR_ERR(gtoc));
+		return;
+	}
+	if (!gtoc->md_toc_init) {
+		pr_err("minidump table not initialized by firmware\n");
+		return;
+	}
+
+	/* the firmware reads this array by physical address */
+	regions = kcalloc(2, sizeof(*regions), GFP_KERNEL);
+	if (!regions)
+		return;
+
+	md_set_region(&regions[n++], "KLOGBUF", virt_to_phys(log_buf_addr_get()),
+		      log_buf_len_get());
+	np = of_find_compatible_node(NULL, NULL, "ramoops");
+	if (np && !of_address_to_resource(np, 0, &res))
+		md_set_region(&regions[n++], "KRAMOOPS", res.start,
+			      resource_size(&res));
+	of_node_put(np);
+
+	toc = &gtoc->md_ss_toc[0];
+	toc->encryption_status = MD_SS_ENCR_DONE;
+	toc->encryption_required = MD_SS_ENCR_NOTREQ;
+	toc->md_ss_smem_regions_baseptr = virt_to_phys(regions);
+	toc->ss_region_count = n;
+	toc->md_ss_toc_init = 1;
+	toc->md_ss_enable_status = MD_SS_ENABLED;
+	pr_info("registered %d regions\n", n);
+}
