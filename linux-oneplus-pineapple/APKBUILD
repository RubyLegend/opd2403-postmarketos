_tag="7.1-rc5" # without 'v' in the beginning
_config="config-$_flavor.$arch"
source="
	$pkgname-$_tag.tar.gz::https://github.com/$_repository/archive/refs/tags/v$_tag.tar.gz
	0001-patch_pineapple_dts.patch
