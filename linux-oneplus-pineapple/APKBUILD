# Kernel config based on: arch/arm64/configs/*idk, upstream?*

maintainer="Serhii Hatsan <serhiihatcan@gmail.com>"
pkgname="linux-oneplus-pineapple"
pkgver=7.1
pkgrel=5
pkgdesc="OnePlus Pad 2 kernel fork"
arch="aarch64"
_carch="arm64"
_flavor="oneplus-pineapple"
url="https://kernel.org"
license="GPL-2.0-only"
options="!strip !check !tracedeps pmb:cross-native"
makedepends="
	bash
	bc
	bison
	clang
	devicepkg-dev
	findutils
	flex
	lld
	llvm
	openssl-dev
	perl
	xz
	zstd
	util-linux
	dtc
	android-tools
"

# Source
_repository="torvalds/linux"
#_commit="ffffffffffffffffffffffffffffffffffffffff"
_tag="7.1-rc5" # without 'v' in the beginning
_config="config-$_flavor.$arch"
source="
	$pkgname-$_tag.tar.gz::https://github.com/$_repository/archive/refs/tags/v$_tag.tar.gz
	0001-patch_pineapple_dts.patch
	0002-patch_pineapple_dts_makefile.patch
	0003-drm-panel-Add-support-for-Novatek-NT36532-panel.patch
	0004-drm-msm-dsi-change-sync-mode-to-sync-on-DSI0-rather-.patch
	0005-drm-msm-dsi-support-DSC-configurations-with-slice_pe.patch
	dummy-dtbo.dtso
	$_config
"
#	patch_pineapple_dts_downstream.patch
#	novatek_nt36532_exp.patch::https://marc.info/?l=linux-kernel&m=175932723017605&q=mbox
#	dsi_slice_per_pkt_exp.patch::https://lore.kernel.org/all/20250220-dual-dsi-v2-3-6c0038d5a2ef@linaro.org/raw
#	vendor.zip::https://github.com/OnePlusOSS/android_kernel_modules_and_devicetree_oneplus_sm8650/archive/refs/heads/oneplus/sm8650_v_15.0.0_pad2.zip
builddir="$srcdir/linux-$_tag"

prepare() {
	default_prepare
	cp "$srcdir/$_config" .config
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" LLVM=1 \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-postmarketOS"

	make ARCH="$_carch" LLVM=1 \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-postmarketOS" dtbs
	
	msg "Compiling dummy DTBO Image..."
	dtc -O dtb -@ -o "$srcdir/dtbo.dtb" "$srcdir/dummy-dtbo.dtso"
	mkdtboimg create "$srcdir/dtbo.img" "$srcdir/dtbo.dtb"
}

package() {
	mkdir -p "$pkgdir"/boot
	make zinstall modules_install dtbs_install \
		ARCH="$_carch" \
		LLVM=1 \
		INSTALL_MOD_STRIP=1 \
		INSTALL_PATH="$pkgdir"/boot \
		INSTALL_MOD_PATH="$pkgdir" \
		INSTALL_DTBS_PATH="$pkgdir/boot/dtbs"

	rm -f "$pkgdir"/usr/lib/modules/*/build "$pkgdir"/usr/lib/modules/*/source

	install -D "$builddir"/include/config/kernel.release \
		"$pkgdir/usr/share/kernel/$_flavor/kernel.release"
	
	# Install the pre-compiled dummy DTBO
	install -Dm644 "$srcdir/dtbo.img" "$pkgdir"/boot/dtbo.img
}

