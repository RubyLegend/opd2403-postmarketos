+		vddneg-supply = <&bl_vddneg_5p5>;
+		current-num-sinks = <5>;
+		kinetic,current-ramp-delay-ms = <128>;
+		kinetic,led-enable-ramp-delay-ms = <1>;
+		kinetic,enable-lcd-bias;
+		kinetic,slave = <&backlight_ktz8866_slave>;
+	};
+};
+
+&gpi_dma1 {
+	status = "okay";
+};
+
+&i2c4 {
+	status = "disabled";
+};
+
+&spi4 {
+	status = "okay";
+	
+	novatek_touch: touch@0 {
+	        compatible = "novatek,nt36532-ts";
+	        reg = <0>;
+	        
+	        /* 12 MHz SPI Clock */
+	        spi-max-frequency = <12000000>;
+	        
+	        interrupt-parent = <&tlmm>;
+	        interrupts = <162 IRQ_TYPE_EDGE_FALLING>;
+		reset-gpios = <&tlmm 161 GPIO_ACTIVE_HIGH>;
+
+		touchscreen-size-y = <30000>;
+		touchscreen-size-x = <21200>;
+		touchscreen-swapped-x-y; // otherwise not matching with physical orientation of panel
+		touchscreen-inverted-x; // required.
+		panel = <&mdss_dsi0_panel>;
+	};
+};
+
+/* Reference the PMK8550 node (which is pmic@0) */
+&pmk8550 {
+	/* Inject the missing Voltage ADC block */
+	vadc: adc@9000 {
+		compatible = "qcom,spmi-adc5-gen3", "qcom,spmi-adc5";
+		reg = <0x9000>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+		#io-channel-cells = <1>;
+
+		/* 0x90 0x01 is the End of Conversion (EOC) interrupt on SPMI */
+		interrupts = <0x0 0x90 0x01 IRQ_TYPE_EDGE_RISING>;
+
+		/* OnePlus Pad 2 Skin Thermistor */
+		channel@144 {
+			reg = <0x144>;
+			qcom,pre-scaling = <1 1>;
+			qcom,hw-settle-time = <200>;
+			qcom,ratiometric;
+			label = "skin_msm_therm";
+		};
+
+		/* Camera Flash Thermistor */
+		channel@145 {
+			reg = <0x145>;
+			qcom,pre-scaling = <1 1>;
+			qcom,hw-settle-time = <200>;
+			qcom,ratiometric;
+			label = "cam_flash_therm";
+		};
+		/* WLAN Thermistor */
+		channel@146 {
+			reg = <0x146>;
+			qcom,pre-scaling = <1 1>;
+			qcom,hw-settle-time = <200>;
+			qcom,ratiometric;
+			label = "wlan_therm";
+		};
+		/* Rear TOF Thermistor */
+		channel@148 {
+			reg = <0x148>;
+			qcom,pre-scaling = <1 1>;
+			qcom,hw-settle-time = <200>;
+			qcom,ratiometric;
+			label = "rear_tof_therm";
+		};
+		/* SVOOC Thermistor */
+		channel@14d {
+			reg = <0x14d>;
+			qcom,pre-scaling = <1 1>;
+			qcom,hw-settle-time = <200>;
+			qcom,ratiometric;
+			label = "svooc_therm";
+		};
+		/* Battery Thermistor */
+		channel@744 {
+			reg = <0x744>;
+			qcom,pre-scaling = <1 1>;
+			qcom,hw-settle-time = <200>;
+			qcom,ratiometric;
+			label = "batt_therm";
+		};
+		/* USB Thermistor */
+		channel@747 {
+			reg = <0x747>;
+			qcom,pre-scaling = <1 1>;
+			qcom,hw-settle-time = <200>;
+			qcom,ratiometric;
+			label = "usb_therm";
+		};
+		/* WLS Thermistor */
+		channel@749 {
+			reg = <0x749>;
+			qcom,pre-scaling = <1 1>;
+			qcom,hw-settle-time = <200>;
+			qcom,ratiometric;
+			label = "wls_therm";
+		};
+	};
+};
+
+
+&pm8550_flash {
+	status = "okay";
+
+	led-0 {
+		function = LED_FUNCTION_FLASH;
+		color = <LED_COLOR_ID_WHITE>;
+
+		/* In mainline, led-sources is 1-indexed. <1> maps to downstream qcom,id = <0> */
+		led-sources = <1>;
+
+		/* Torch mode maximum (500 mA) */
+		led-max-microamp = <500000>;
+
+		/* Flash strobe maximum (1.5 A) */
+		flash-max-microamp = <1500000>;
+		flash-max-timeout-us = <1280000>;
+	};
+
+};
